DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-me-with-a-long-random-string"
PYTHON_BIN=".venv/bin/python"
AI_COMMENT_MODEL="gpt-5.4"
ANTHROPIC_API_KEY=""
# Optional server-wide default agent model when a document has none configured.
# Accepts a canonical Anthropic id (claude-sonnet-5 / claude-fable-5-1 /
# claude-opus-5) or an OpenRouter model as openrouter/<author>/<model>.
# CLAUDE_AGENT_MODEL="claude-sonnet-5"
# Effective context window Claude Code auto-compacts against. The app injects
# a default of 150000 into every run (DEFAULT_AUTO_COMPACT_WINDOW in
# agent-core/agent-env.ts) so compaction fires with real headroom below the
# 200k model window. Anthropic runs authenticated with an API key additionally
# get the context-1m-2025-08-07 beta, which raises the model window to 1M; those
# runs use 500000 instead (LONG_CONTEXT_AUTO_COMPACT_WINDOW). Values >= the
# effective model window are clamped away by the CLI and therefore do nothing;
# the floor is 100000 and the ceiling 1000000. Setting this here (or in a
# document's env) pins the window for BOTH cases.
# CLAUDE_CODE_AUTO_COMPACT_WINDOW="150000"
# NOTE: OPENROUTER_API_KEY is NOT a server env var — it is a per-document
# secret set via the document's Env menu (DocumentEnvVar) and unlocks the
# OpenRouter section of the model selector for that document.
# LiteLLM works the same way: LITELLM_API_KEY is per-document only. The base
# URL is not a secret, so a server-wide default may be set here (per-document
# LITELLM_BASE_URL overrides it). With the container runner, "localhost" means
# the container — use host.docker.internal to reach a proxy on the host.
# LITELLM_BASE_URL="http://host.docker.internal:9274"
# Canonical public origin. Used to build redirect/share URLs and to allow-list
# the X-Forwarded-Host header (prevents host-header open redirects that could
# leak share tokens). e.g. https://docs.nielsrolf.com
APP_URL="http://localhost:14141"
# Optional comma-separated extra hosts to trust in X-Forwarded-Host.
# ALLOWED_HOSTS="docs.nielsrolf.com,localhost:14141"

# Slack bot (claudex). Socket Mode: the app-level token is per APP, the bot
# token is per WORKSPACE. See slack-manifest.json for the app configuration.
# SLACK_APP_TOKEN="xapp-..."         # app-level token (connections:write) — required for the bot
# SLACK_BOT_TOKEN="xoxb-..."         # bot token of the home workspace (optional once other workspaces are installed via OAuth)
# SLACK_SIGNING_SECRET=""
# Installing claudex into OTHER Slack workspaces (Settings → Notifications → "Add claudex to another Slack workspace"):
# SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET=""             # redirect URL must be <APP_URL>/api/slack/oauth/callback
