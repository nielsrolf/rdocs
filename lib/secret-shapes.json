{
  "comment": "Shapes of well-known credentials, shared by lib/secret-redaction.ts (run time) and scripts/redact-stored-secrets.py (existing data). Syntax must be valid for BOTH JavaScript and Python regular expressions. `prefix` is how many leading characters of a match stay readable; the rest becomes `*`, so a masked value never matches its own shape again and its length is unchanged. `anchors` are the literal strings every match starts with; the script uses them to find candidates quickly in gigabytes of data.",
  "boundary": "(?<![A-Za-z0-9_-])",
  "shapes": [
    {
      "name": "GitHub token",
      "pattern": "(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,})",
      "prefix": 4,
      "anchors": [
        "ghp_",
        "gho_",
        "ghu_",
        "ghs_",
        "ghr_",
        "github_pat_"
      ]
    },
    {
      "name": "GitHub basic credential",
      "pattern": "eC1hY2Nlc3MtdG9rZW46[A-Za-z0-9+/=]{16,}",
      "prefix": 20,
      "anchors": [
        "eC1hY2Nlc3MtdG9rZW46"
      ]
    },
    {
      "name": "Anthropic key",
      "pattern": "sk-ant-[A-Za-z0-9_-]{20,}",
      "prefix": 7,
      "anchors": [
        "sk-ant-"
      ]
    },
    {
      "name": "OpenAI-style key",
      "pattern": "sk-(?!ant-)(?:proj-|or-v1-)?[A-Za-z0-9_-]{32,}",
      "prefix": 3,
      "anchors": [
        "sk-"
      ]
    },
    {
      "name": "Hugging Face token",
      "pattern": "hf_[A-Za-z0-9]{30,}",
      "prefix": 3,
      "anchors": [
        "hf_"
      ]
    },
    {
      "name": "Slack token",
      "pattern": "xox[abpors]-[A-Za-z0-9-]{20,}",
      "prefix": 5,
      "anchors": [
        "xoxa-",
        "xoxb-",
        "xoxp-",
        "xoxo-",
        "xoxr-",
        "xoxs-"
      ]
    },
    {
      "name": "Google API key",
      "pattern": "AIza[0-9A-Za-z_-]{35}",
      "prefix": 4,
      "anchors": [
        "AIza"
      ]
    },
    {
      "name": "RunPod key",
      "pattern": "rpa_[A-Z0-9]{30,}",
      "prefix": 4,
      "anchors": [
        "rpa_"
      ]
    },
    {
      "name": "r-docs token",
      "pattern": "gdai_[A-Za-z0-9_-]{20,}",
      "prefix": 5,
      "anchors": [
        "gdai_"
      ]
    },
    {
      "name": "Tinker key",
      "pattern": "tml-(?!rdocs-vk-)[A-Za-z0-9_-]{20,}",
      "prefix": 4,
      "anchors": [
        "tml-"
      ]
    },
    {
      "name": "OpenWeights key",
      "pattern": "ow_(?!rdocs-vk-)[A-Za-z0-9]{32,}",
      "prefix": 3,
      "anchors": [
        "ow_"
      ]
    },
    {
      "name": "Modal token",
      "pattern": "a[ks]-[A-Za-z0-9]{20,}",
      "prefix": 3,
      "anchors": [
        "ak-",
        "as-"
      ]
    }
  ],
  "privateKey": {
    "name": "private key block",
    "anchors": [
      "-----BEGIN "
    ],
    "comment": "Everything between BEGIN and END is key material plus whatever a tool wrapped around the lines (JSON quotes, diff markers, escaped newlines): runs matching `run` are masked, the wrapping stays. Without an END within maxBody characters the text was clipped; then `clippedRun` is masked in the next clippedMax characters.",
    "begin": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
    "end": "-----END [A-Z ]*PRIVATE KEY-----",
    "run": "(?<!\\\\)[A-Za-z0-9+/=]{4,}",
    "maxBody": 20000,
    "clippedRun": "(?<!\\\\)[A-Za-z0-9+/=]{24,}",
    "clippedMax": 8000
  }
}
