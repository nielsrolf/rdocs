{
  "comment": "Shapes of well-known credentials, shared by lib/secret-redaction.ts (run time) and scripts/redact-stored-secrets.py (existing data). Syntax must be valid for BOTH JavaScript and Python regular expressions. `prefix` is how many leading characters of a match stay readable; the rest becomes `*`, so a masked value never matches its own shape again and its length is unchanged.",
  "boundary": "(?<![A-Za-z0-9_-])",
  "shapes": [
    { "name": "GitHub token", "pattern": "(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{20,})", "prefix": 4 },
    { "name": "GitHub basic credential", "pattern": "eC1hY2Nlc3MtdG9rZW46[A-Za-z0-9+/=]{16,}", "prefix": 20 },
    { "name": "Anthropic key", "pattern": "sk-ant-[A-Za-z0-9_-]{20,}", "prefix": 7 },
    { "name": "OpenAI-style key", "pattern": "sk-(?!ant-)(?:proj-|or-v1-)?[A-Za-z0-9_-]{32,}", "prefix": 3 },
    { "name": "Hugging Face token", "pattern": "hf_[A-Za-z0-9]{30,}", "prefix": 3 },
    { "name": "Slack token", "pattern": "xox[abpors]-[A-Za-z0-9-]{20,}", "prefix": 5 },
    { "name": "Google API key", "pattern": "AIza[0-9A-Za-z_-]{35}", "prefix": 4 },
    { "name": "RunPod key", "pattern": "rpa_[A-Z0-9]{30,}", "prefix": 4 },
    { "name": "r-docs token", "pattern": "gdai_[A-Za-z0-9_-]{20,}", "prefix": 5 },
    { "name": "Tinker key", "pattern": "tml-(?!rdocs-vk-)[A-Za-z0-9_-]{20,}", "prefix": 4 }
  ],
  "privateKey": {
    "name": "private key block",
    "pattern": "(-----BEGIN [A-Z ]*PRIVATE KEY-----)((?:[A-Za-z0-9+/=\\s]|\\\\+[rn])*)"
  }
}
